# Application Mode
APP_ENV=development
PORT=8000

# AWS Credentials (Local mock/testing only; on EC2 use IAM roles)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AI Service Configuration
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini

# Watchdog Thresholds (Rules Engine)
DEFAULT_IDLE_HOURS_THRESHOLD=4
DEFAULT_CPU_IDLE_PERCENT=2.5